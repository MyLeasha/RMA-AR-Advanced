<?xml version="1.0" encoding="utf-8"?>
<!--
	RMA Compliance AR - IIS settings for this folder (V3)

	- index.html and version.json: browsers must check with the server on every scan
	  (Cache-Control: no-cache). Unchanged files answer "304 Not Modified", so this stays fast.
	- app/, lib/ and assets/: browsers may keep files for a year. This is safe because
	  index.html requests them with ?v=<version>, so a new version means a new address.
	- Adds the file types IIS does not know by default (.glb, .mind, .json).

	If the folder returns "500 Internal Server Error" after uploading this file, the server
	does not allow these settings here: delete web.config and ask the LMS administrator to
	apply the same settings at server level (see the deployment guide, section 3).
-->
<configuration>
	<system.webServer>
		<staticContent>
			<remove fileExtension=".glb" />
			<mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
			<remove fileExtension=".mind" />
			<mimeMap fileExtension=".mind" mimeType="application/octet-stream" />
			<remove fileExtension=".json" />
			<mimeMap fileExtension=".json" mimeType="application/json" />
			<clientCache cacheControlMode="DisableCache" />
		</staticContent>
	</system.webServer>
	<location path="app">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
			</staticContent>
		</system.webServer>
	</location>
	<location path="lib">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
			</staticContent>
		</system.webServer>
	</location>
	<location path="assets">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
			</staticContent>
		</system.webServer>
	</location>
</configuration>
